# Local development environment for RelationScope.
# Copy this file to .env and adjust values for your machine.

# Prefer the local open-set bundle when it is available.
RELATIONSCOPE_MODEL_DIR=artifacts/open_set/best

# Optional fallback: used only when RELATIONSCOPE_MODEL_DIR is not a complete bundle.
RELATIONSCOPE_MODEL_GCS_URI=

# cpu | cuda | mps | auto
RELATIONSCOPE_DEVICE=cpu

# V2 operational store. Leave bucket empty for local filesystem persistence.
RELATIONSCOPE_OPS_BUCKET=
RELATIONSCOPE_OPS_PREFIX=v2
RELATIONSCOPE_OPS_DIR=artifacts/ops

# V2 model registry.
RELATIONSCOPE_MODEL_RELEASES_PREFIX=models/releases

# V2 async batch. When these are not set, local development runs jobs inline.
GOOGLE_CLOUD_PROJECT=
RELATIONSCOPE_TASK_LOCATION=
RELATIONSCOPE_TASK_QUEUE=
RELATIONSCOPE_TASK_SERVICE_ACCOUNT=


# V3 document intelligence. Empty uses the built-in deterministic heuristic extractor.
RELATIONSCOPE_NER_MODEL=
RELATIONSCOPE_NER_DEVICE=cpu
RELATIONSCOPE_DEPLOYMENT_VARIANT=champion

# V3 canary metadata (normally injected by Terraform in production).
RELATIONSCOPE_CANARY_PERCENT=0
RELATIONSCOPE_CHALLENGER_API_URL=
